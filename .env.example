# -----------------------------------------------------------------------------
# Envoy — variables d'environnement
# Copier vers `.env` (déjà ignoré par git) et coller les clés.
# Ne jamais committer `.env`.
# -----------------------------------------------------------------------------

# --- Supabase / Postgres ------------------------------------------------------
# Dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dashboard → Project Settings → Database
# Mot de passe de la base (pas une clé API).
SUPABASE_DB_PASSWORD=

# Colle l'URI « Session pooler » ou « Direct connection ».
# Le code ajoute le driver asyncpg et active SSL si l'hôte est Supabase.
# Évite le transaction pooler (port 6543) : les migrations Alembic en ont besoin.
# Exemple :
# postgresql://postgres.[ref]:[MOT_DE_PASSE]@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Optionnel. Connexion directe (db.[ref].supabase.co:5432) si DATABASE_URL
# passe par le pooler. Alembic l'utilise en priorité.
DIRECT_DATABASE_URL=

# Secours local uniquement si DATABASE_URL est vide.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- AWS SES v2 ---------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3
AWS_SES_CONFIGURATION_SET=
# Optionnel. ARN des topics SNS acceptés sur /webhooks/ses (séparés par des virgules).
# Vide = tout topic du compte AWS des identifiants ci-dessus.
SES_SNS_TOPIC_ARNS=
MAIL_FROM_LOCAL_PART=noreply
PLATFORM_FROM_DOMAIN=flowenagency.com
# Optionnel. Sinon MAIL_FROM_LOCAL_PART@PLATFORM_FROM_DOMAIN.
DEFAULT_FROM_EMAIL=
PUBLIC_APP_URL=http://localhost:5173
# URL publique de l'API (enregistrement webhooks Resend/Brevo/Mailtrap).
PUBLIC_API_URL=https://envoy.flowenagency.com

# --- Multi-provider (SES first si dispo, puis la liste) ------------------------
PROVIDER_POLICY=ses_first
FALLBACK_EMAIL_PROVIDERS=resend,brevo,mailtrap
RESEND_API_KEY=
BREVO_API_KEY=
MAILTRAP_API_TOKEN=# Resend = signing secret Svix (whsec_…). Brevo = bearer token. Mailtrap = HMAC secret.
WEBHOOK_SECRET_RESEND=
WEBHOOK_SECRET_BREVO=
WEBHOOK_SECRET_MAILTRAP=

# --- Sécurité applicative -----------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# Clé distincte pour chiffrer les secrets stockés (webhooks, clés DKIM).
# Les valeurs chiffrées avec SECRET_KEY sont relues puis re-chiffrées au démarrage.
ENCRYPTION_KEY=
API_KEY_PREFIX=envoy_live_
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
INVITE_TOKEN_EXPIRE_HOURS=48

# Premier administrateur, créé au démarrage s'il n'existe pas encore.
# Laisse vide tant que tu ne veux pas d'amorçage.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- API ----------------------------------------------------------------------
APP_NAME=Envoy
# En production : APP_ENV=production (webhooks fail-closed, /docs désactivé).
APP_ENV=development
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
API_V1_PREFIX=/api/v1
# Optionnel : regex d'origines en plus (ex. previews Vercel).
# CORS_ORIGIN_REGEX=^https://envoy-web-.*\.vercel\.app$

# --- Production ---------------------------------------------------------------
# Coolify (même serveur que Supabase) :
#   DATABASE_URL=postgresql://postgres:<mot de passe>@<nom du conteneur supabase-db>:5432/postgres
#   Pas de tunnel SSH : l'API rejoint le réseau Docker de Supabase.
# Vercel : la base doit être joignable depuis Internet (port publié + SSL).
#   DATABASE_SSL=true force le SSL quel que soit l'hôte.
# Toujours en prod :
#   APP_ENV=production
#   DEBUG=false            (DEBUG=true journalise le SQL et ses paramètres)
#   CORS_ORIGINS=https://app.ton-domaine.com
#   PUBLIC_APP_URL=https://app.ton-domaine.com   (liens d'invitation)
# DATABASE_SSL=
# SEND_INLINE=           (vide = auto : activé sur Vercel)
# DNS_RECHECK_SECONDS=30 (revérifie les domaines mal configurés ; 0 = off, ignoré sur Vercel)
# RUN_MIGRATIONS=true    (image Docker : alembic upgrade head au démarrage)
# WEB_CONCURRENCY=1
