# -----------------------------------------------------------------------------
# Envoy — variables d'environnement
# Copier ce fichier vers `.env` et adapter les valeurs avant le premier lancement.
# docker compose up --build
# -----------------------------------------------------------------------------

# PostgreSQL
POSTGRES_USER=envoy
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=envoy
POSTGRES_HOST=db
POSTGRES_PORT=5432

# SQLAlchemy async (hôte `db` = service Docker Compose).
# Hors conteneur, remplacer `db` par `localhost`.
DATABASE_URL=postgresql+asyncpg://envoy:change_me_strong_password@db:5432/envoy

# AWS SES v2 (laisser vide pour s'appuyer sur la chaîne de credentials IAM / profil local)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3
AWS_SES_CONFIGURATION_SET=

# Sécurité applicative
# Générer une clé : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change_me_generate_a_long_random_secret
API_KEY_PREFIX=envoy_live_
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
INVITE_TOKEN_EXPIRE_HOURS=48

# API
APP_NAME=Envoy
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
API_V1_PREFIX=/api/v1
