{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "web",
      "framework": "vite",
      "rewrites": [
        { "source": "/((?!\\.well-known/).*)", "destination": "/index.html" }
      ],
      "headers": [
        {
          "source": "/assets/(.*)",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        },
        {
          "source": "/sw.js",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/manifest.webmanifest",
          "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }]
        }
      ]
    },
    "app": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "app.main:app",
      "functions": {
        "app/main.py": {
          "maxDuration": 60
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "app" } },
    { "source": "/health", "destination": { "service": "app" } },
    { "source": "/ready", "destination": { "service": "app" } },
    { "source": "/openapi.json", "destination": { "service": "app" } },
    { "source": "/redoc", "destination": { "service": "app" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
